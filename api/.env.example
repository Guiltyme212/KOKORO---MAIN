PORT=8787
LOG_LEVEL=debug

# Which LLM writes the meditation script: "anthropic" (via cli-proxy) or "openai".
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_BASE_URL=https://ourcliproxy-production.up.railway.app
ANTHROPIC_API_KEY=set-in-railway-min-20-chars
ANTHROPIC_MODEL=claude-opus-4-7

# Required when LLM_PROVIDER=openai. OPENAI_MODEL defaults to gpt-4o.
# OPENAI_API_KEY=set-in-railway-min-20-chars
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Optional for backend voice/audio URL flow. Text/browser-STT flow does not need it.
# ELEVENLABS_API_KEY=set-in-railway-min-20-chars
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_MODEL=scribe_v2
# WHISPER_API_KEY=set-in-railway-min-20-chars
# WHISPER_BASE_URL=https://api.openai.com/v1   # override only for self-hosted whisper
SUNO_BASE_URL=https://api.sunoapi.org
SUNO_API_KEY=set-in-railway-min-20-chars
SUNO_CALLBACK_URL=http://localhost:8787/suno/callback

BLOB_DRIVER=filesystem
BLOB_FS_DIR=./blob-data
CORS_ORIGIN=http://localhost:5173
REFERENCE_PUBLIC_BASE_URL=http://localhost:8787/refs
